# inicio file: .gitignore

# Built application files
*.apk
*.aar
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
**/build/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, api keys, etc.)
local.properties

# Proguard / R8 folder generated by Eclipse / Android Studio
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.idea/navEditor.xml
.idea/caches/
.idea/workspace.xml
.idea/libraries/
.idea/modules.xml
.idea/assetWizardSettings.xml
.idea/

# Android Studio / IntelliJ project files
*.iml
*.ipr
*.iws

# External native build folder
.externalNativeBuild
.cxx/

# Google Services / Signing (por seguridad)
keystore.properties
# google-services.json
# *.jks
# *.keystore

# Local history (VS Code / plugins)
.history/

# OS specific files
.DS_Store
Thumbs.db

# fin file: .gitignore